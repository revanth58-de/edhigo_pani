# ─── DINASARI Backend — Production Environment Variables ───────────────────
#
# Copy this file to .env and fill in all values before deploying.
# NEVER commit your real .env to git.
#
# Generate strong secrets:
#   node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
#   or: openssl rand -base64 64

# ── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production
API_BASE_URL="https://www.dinasari.co.in"

# ── Database ─────────────────────────────────────────────────────────────────
# Use PostgreSQL in production — NOT SQLite!
# Connection pool params for hosted PostgreSQL (Neon / Supabase / AWS RDS):
#   connection_limit=10  → max 10 simultaneous DB connections
#   pool_timeout=20      → fail fast after 20s if no connection is free
# Example: postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public&sslmode=require&connection_limit=10&pool_timeout=20
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/dinasari?schema=public&sslmode=require&connection_limit=10&pool_timeout=20"

# ── JWT Secrets ───────────────────────────────────────────────────────────────
# MUST be changed — use long, random, unique strings for each secret (min 64 chars)
JWT_SECRET="REPLACE_WITH_STRONG_RANDOM_SECRET_64_CHARS_MIN"
JWT_REFRESH_SECRET="REPLACE_WITH_DIFFERENT_STRONG_RANDOM_SECRET_64_CHARS_MIN"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# ── OTP ──────────────────────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=5

# ── Admin Panel ───────────────────────────────────────────────────────────────
# ADMIN_SECRET: The master password used to authenticate as admin. Change this!
ADMIN_SECRET="REPLACE_WITH_STRONG_ADMIN_PASSWORD"
# ADMIN_JWT_SECRET: Signs short-lived admin JWT tokens (2h TTL). Must be different from JWT_SECRET.
ADMIN_JWT_SECRET="REPLACE_WITH_ANOTHER_STRONG_64_CHAR_RANDOM_STRING"

# ── SMS (Fast2SMS) ────────────────────────────────────────────────────────────
# Get your API key from https://fast2sms.com/dashboard/keys
FAST2SMS_API_KEY="YOUR_FAST2SMS_API_KEY_HERE"

# ── Payment Gateway (Razorpay) ────────────────────────────────────────────────
# Get API keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID="rzp_live_YOUR_KEY_ID"
RAZORPAY_KEY_SECRET="YOUR_RAZORPAY_KEY_SECRET"

# ── Media Uploads (Cloudinary) ────────────────────────────────────────────────
# Get credentials from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME="YOUR_CLOUDINARY_CLOUD_NAME"
CLOUDINARY_API_KEY="YOUR_CLOUDINARY_API_KEY"
CLOUDINARY_API_SECRET="YOUR_CLOUDINARY_API_SECRET"

# ── Crash Reporting (Sentry) ──────────────────────────────────────────────────
# Get this from sentry.io -> Project Settings -> Client Keys (DSN)
SENTRY_DSN="https://YOUR_KEY@YOUR_ORG.ingest.sentry.io/YOUR_PROJECT_ID"

# ── CORS & Security ───────────────────────────────────────────────────────────
# Restrict to exact production domain (no wildcard * in production)
ALLOWED_ORIGIN="https://www.dinasari.co.in"

# ── Geofencing ────────────────────────────────────────────────────────────────
# Enforce 100m GPS proximity verification for worker check-in and check-out QR scans
GEOFENCE_ENABLED=true

# ── Real-Time / Redis (Optional Socket.io scaling) ─────────────────────────────
# REDIS_URL="redis://default:password@host:6379"

# ── GCP Cloud Logging (Optional) ──────────────────────────────────────────────
# GCP_PROJECT_ID="your-gcp-project-id"
# GCP_KEY_FILE="/path/to/service-account.json"
