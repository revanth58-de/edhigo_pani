generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────── MODELS ────────────

model User {
  id          String   @id @default(uuid())
  phone       String   @unique
  name        String?
  role        Role?
  language    String   @default("te") // "te" | "hi" | "en"
  village     String?
  age         Int?     // Age of the user (must be >= 18 for workers)
  gender      String?  // "male" | "female" | "other"
  photoUrl    String?
  landAcres   Float?
  skills      Json?    // ["plowing", "seeding"]
  ratingAvg   Float    @default(0)
  ratingCount Int      @default(0)
  status      Status   @default(offline)
  pushToken   String?  // Expo push notification token
  otp           String?
  otpExpiresAt  DateTime?
  otpFailCount  Int      @default(0)  // S3: tracks consecutive wrong OTP attempts (max 5)
  experience    Int?     // Years of farming experience (set by worker)
  avatarIcon  String?  // Profile icon key e.g. 'person', 'agriculture'
  matchingRadius Float?   // B10: custom matching radius preference (in km)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime? // S4: soft-delete — set instead of destroying the row

  // Isolated Location and Normalized Animals relations
  location    UserLocation?
  animals     UserAnimal[]

  // Relations
  jobsPosted       Job[]             @relation("FarmerJobs")
  attendances      Attendance[]
  paymentsMade     Payment[]         @relation("FarmerPayments")
  paymentsReceived Payment[]         @relation("WorkerPayments")
  ratingsGiven     Rating[]          @relation("RaterRatings")
  ratingsReceived  Rating[]          @relation("RateeRatings")
  groupsLed        Group[]
  groupMemberships GroupMember[]
  applications     JobApplication[]
  groupMessages    GroupMessage[]
  refreshTokens    RefreshToken[]
  settlements      Settlement[]
  auditLogs        AuditLog[]        // Actions performed if user is an admin
  disputesFiled    Dispute[]         @relation("InitiatorDisputes")
  notifications    Notification[]    @relation("UserNotifications")
  machineries      Machinery[]       @relation("UserMachinery")
  machineryBookings MachineryBooking[] @relation("FarmerMachineryBookings")

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Job {
  id            String   @id @default(uuid())
  farmerId      String
  workType      String   // "sowing" | "harvesting" | "irrigation" | "labour" | "tractor"
  workerType    String   @default("individual") // "individual" | "group"
  workersNeeded Int      @default(1)
  payPerDay     Float
  farmLatitude  Float?
  farmLongitude Float?
  farmAddress   String?
  description   String?  // FIX #14: Free-text job instructions (e.g. "Bring your own tools, report at 6am")
  status        String   @default("pending") // "pending" | "matched" | "in_progress" | "completed" | "cancelled"
  startTime     DateTime?
  endTime       DateTime?
  durationDays  Int?     // D5: duration of the job in days
  radiusKm      Float?    // B10: custom matching radius for this job (in km)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  farmer       User             @relation("FarmerJobs", fields: [farmerId], references: [id])
  attendances  Attendance[]
  payments     Payment[]
  ratings      Rating[]
  applications JobApplication[]
  disputes     Dispute[]

  @@index([status])           // Filter by status on every worker feed load
  @@index([farmerId])         // Farmer's own jobs list
  @@index([workerType, status]) // Match group vs individual jobs
  @@index([farmerId, status])   // Farmer dashboard: my active/pending jobs
  @@index([createdAt])          // History feed ordering
  @@map("jobs")
}

model Attendance {
  id               String    @id @default(uuid())
  jobId            String?
  bookingId        String?
  workerId         String
  qrCodeIn         String?
  qrCodeOut        String?
  checkIn          DateTime?
  checkOut         DateTime?
  checkInLatitude  Float?
  checkInLongitude Float?
  checkOutLatitude Float?
  checkOutLongitude Float?
  hoursWorked      Float?
  createdAt        DateTime  @default(now())

  // Relations
  job      Job?              @relation(fields: [jobId], references: [id])
  booking  MachineryBooking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  worker   User              @relation(fields: [workerId], references: [id])

  @@index([jobId])              // Fetch all attendances for a job
  @@index([bookingId])
  @@index([workerId])           // Fetch a worker's attendance history
  @@map("attendances")
}

model Payment {
  id               String   @id @default(uuid())
  jobId            String?
  bookingId        String?
  farmerId         String
  workerId         String
  amount           Float
  commissionAmount Float    @default(0)
  workerAmount     Float    @default(0)
  method           String   // "cash" | "upi" | "card" | "netbanking"
  upiRef           String?
  transactionId    String?
  status           String   @default("pending") // "pending" | "completed" | "failed"
  settlementStatus String   @default("pending") // "pending" | "settled"
  paidAt           DateTime?
  notes            String?  // D4: additional payment context/notes
  receiptUrl       String?  // D4: link to cash receipt image/doc
  createdAt        DateTime @default(now())

  // Relations
  job         Job?         @relation(fields: [jobId], references: [id])
  booking     MachineryBooking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  farmer      User         @relation("FarmerPayments", fields: [farmerId], references: [id])
  worker      User         @relation("WorkerPayments", fields: [workerId], references: [id])
  settlements Settlement[]
  disputes    Dispute[]

  @@index([farmerId, workerId])  // Payment history for farmer or worker
  @@index([upiRef])              // FIX #9: Fast duplicate UPI transaction check
  @@map("payments")
}

model Settlement {
  id        String   @id @default(uuid())
  workerId  String
  paymentId String
  amount    Float
  status    String   @default("pending") // "pending" | "processing" | "settled"
  settledAt DateTime?
  createdAt DateTime @default(now())

  // Relations
  worker  User    @relation(fields: [workerId], references: [id])
  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([workerId])
  @@map("settlements")
}

model Rating {
  id         String   @id @default(uuid())
  jobId      String
  fromUserId String
  toUserId   String
  stars      Int      // D6: 1-5 stars only (emoji is dynamically mapped on read/write)
  createdAt  DateTime @default(now())

  // Relations
  job      Job  @relation(fields: [jobId], references: [id])
  fromUser User @relation("RaterRatings", fields: [fromUserId], references: [id])
  toUser   User @relation("RateeRatings", fields: [toUserId], references: [id])

  @@unique([jobId, fromUserId, toUserId])  // Prevent rating the same person twice per job
  @@index([toUserId])                      // Profile and leaderboard queries
  @@map("ratings")
}

model Group {
  id          String   @id @default(uuid())
  leaderId    String
  name        String?
  type        String?  // "General" | "Seasonal" | "Specialized"
  description String?
  photoUrl    String?
  qrCode      String?
  status      String   @default("forming") // "forming" | "active" | "completed"
  maxMembers  Int?     @default(20)         // D9: enforces group capacity cap
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  leader   User           @relation(fields: [leaderId], references: [id])
  members  GroupMember[]
  messages GroupMessage[]

  @@map("groups")
}

model GroupMessage {
  id        String   @id @default(uuid())
  groupId   String
  senderId  String
  content   String
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
  deletedAt DateTime?

  // Relations
  group  Group @relation(fields: [groupId], references: [id])
  sender User  @relation(fields: [senderId], references: [id])

  @@index([groupId, createdAt]) // Optimize fetching historical chat
  @@map("group_messages")
}

model GroupMember {
  id        String    @id @default(uuid())
  groupId   String
  workerId  String
  name      String?   // Leader-defined name
  role      String?   // Leader-defined role (e.g., "Site Supervisor")
  status    String    @default("invited") // "invited" | "joined" | "checked_in" | "checked_out"
  joinedAt  DateTime?
  createdAt DateTime  @default(now())

  // Relations
  group  Group @relation(fields: [groupId], references: [id])
  worker User  @relation(fields: [workerId], references: [id])

  @@unique([groupId, workerId])   // Prevent duplicate membership for same worker+group
  @@map("group_members")
}

model JobApplication {
  id        String   @id @default(uuid())
  jobId     String
  workerId  String
  groupId   String?
  status    String   @default("pending") // "pending" | "accepted" | "rejected" | "withdrawn"
  distance  Float?
  appliedAt DateTime @default(now())

  // Relations
  job    Job  @relation(fields: [jobId], references: [id])
  worker User @relation(fields: [workerId], references: [id])

  @@unique([jobId, workerId])  // Prevent duplicate applications
  @@index([workerId])          // Worker's application history
  @@index([jobId])             // All applicants for a job
  @@map("job_applications")
}

// A1: Audit log for tracking administrative actions
model AuditLog {
  id        String   @id @default(uuid())
  adminId   String
  action    String   // "suspend_user", "reinstate_user", "delete_user", etc.
  targetId  String?  // ID of the user/job that was modified
  details   Json?    // Optional extra context
  createdAt DateTime @default(now())

  // Relations
  admin     User     @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([action])
  @@map("audit_logs")
}

// ─── NEW NORMALIZED MODELS & ENUMS ───

enum Role {
  farmer
  worker
  leader
  machinery
}

enum Status {
  available
  working
  on_break
  offline
  suspended
  online
}

model UserLocation {
  userId    String   @id
  latitude  Float
  longitude Float
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_locations")
}

model UserAnimal {
  id     String @id @default(uuid())
  userId String
  type   String
  count  Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("user_animals")
}

model Dispute {
  id                String   @id @default(uuid())
  jobId             String
  initiatorId       String
  paymentId         String?
  category          String   // e.g. "payment_delayed", "hours_incorrect", "worker_no_show", "other"
  description       String
  status            String   @default("pending") // "pending" | "investigating" | "resolved" | "dismissed"
  resolutionDetails String?
  resolvedAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  initiator User     @relation("InitiatorDisputes", fields: [initiatorId], references: [id], onDelete: Cascade)
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@map("disputes")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String
  data      Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

model Machinery {
  id           String             @id @default(uuid())
  ownerId      String
  type         String             // "Tractor" | "Harvester" | "Pump Set" | "Plough" | "Sprayer" | "Thresher"
  name         String             // e.g. "John Deere 5050D"
  pricePerHour Float
  photoUrl     String?
  latitude     Float?
  longitude    Float?
  status       String             @default("available") // "available" | "unavailable"
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  owner    User               @relation("UserMachinery", fields: [ownerId], references: [id], onDelete: Cascade)
  bookings MachineryBooking[]

  @@index([ownerId])
  @@map("machineries")
}

model MachineryBooking {
  id           String   @id @default(uuid())
  machineryId  String
  farmerId     String
  date         DateTime
  slot         String   // "Morning" | "Afternoon" | "Full Day"
  totalAmount  Float
  status       String   @default("pending") // "pending" | "confirmed" | "cancelled"
  latitude     Float?
  longitude    Float?
  address      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  machinery   Machinery    @relation(fields: [machineryId], references: [id], onDelete: Cascade)
  farmer      User         @relation("FarmerMachineryBookings", fields: [farmerId], references: [id], onDelete: Cascade)
  attendances Attendance[]
  payments    Payment[]

  @@index([machineryId])
  @@index([farmerId])
  @@map("machinery_bookings")
}
