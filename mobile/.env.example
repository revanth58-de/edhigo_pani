# ── DINASARI Mobile App — Environment Variables ──
# Copy to .env for local development or EAS build secrets.

# Backend API URL (Production: https://www.dinasari.co.in)
EXPO_PUBLIC_API_URL=https://www.dinasari.co.in

# Sentry Crash Reporting
EXPO_PUBLIC_SENTRY_DSN=YOUR_SENTRY_DSN

# Google Maps API Key (Loaded dynamically via app.config.js)
# IMPORTANT: Restrict this key in Google Cloud Console:
#  - Android: Package name `com.dinasari.app` + SHA-1 certificate fingerprint
#  - iOS: Bundle ID `com.dinasari.app`
#  - Web: HTTP Referrer restriction
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# OpenWeatherMap API Key (Optional)
EXPO_PUBLIC_OPENWEATHER_API_KEY=YOUR_OPENWEATHER_API_KEY